# Salin ke backend/.env untuk menjalankan API langsung di host (npm run start:dev).
# Nilai di bawah cocok dengan service di docker-compose.yml (port yang dipublish ke localhost).
# Saat API jalan di dalam Docker Compose, host diganti otomatis (postgres, redis, minio, mailpit).
# Semua variabel wajib kecuali yang ditandai opsional; aplikasi menolak start jika ada yang kurang.

# Opsional (default: development, 3000, info)
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL 16
DATABASE_URL=postgresql://hris:hris@localhost:5432/hris?schema=public

# Redis 7 (cache dan antrean BullMQ)
REDIS_URL=redis://localhost:6379

# JWT: masing-masing minimal 32 karakter dan harus berbeda.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=ganti-dengan-secret-acak-minimal-32-karakter-akses
JWT_REFRESH_SECRET=ganti-dengan-secret-acak-minimal-32-karakter-refresh

# Penyimpanan file S3-compatible (MinIO di lokal)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=hris-files
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Email (Mailpit di lokal, UI di http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="HRIS Blue Rose Tech <no-reply@bluerose.test>"

# Origin frontend yang boleh memanggil API dengan cookie (CORS credentials)
FRONTEND_URL=http://localhost:5173

# Zona waktu proses (presensi dan payroll dihitung dalam WIB)
TZ=Asia/Jakarta

# --- Hanya untuk Prisma CLI dan seed (tidak dibaca aplikasi) ---

# Opsional. Password akun demo hr@bluerose.test dan karyawan@bluerose.test
# yang dibuat `npm run db:seed` (default: BlueRose#2026, minimal 8 karakter).
# SEED_DEMO_PASSWORD=

# Opsional. Kosongkan saat memakai PostgreSQL dari Docker Compose: `migrate dev`
# membuat shadow database sendiri. Isi hanya untuk server yang tidak bisa
# CREATE DATABASE, misalnya `npx prisma dev` (lihat README).
# SHADOW_DATABASE_URL=
