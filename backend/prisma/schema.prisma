// Skema database HRIS Blue Rose Tech.
//
// Aturan:
// - Perubahan skema hanya lewat `npx prisma migrate dev --name <nama>`.
//   Jangan edit migrasi yang sudah ada dan jangan ubah database secara manual.
// - Kolom uang memakai tipe Decimal (Prisma.Decimal di kode), tidak pernah Float.
// - Nama model/field camelCase di kode, snake_case di database (@map/@@map).
// - id = UUIDv7 (urut waktu, index B-tree tidak terfragmentasi), dibuat Prisma Client.
// - Timestamp memakai timestamptz; tanggal kalender (lahir, masuk, libur) memakai date.
// - CHECK constraint (format NIP, jam shift, koordinat) ada di SQL migrasi
//   karena Prisma Schema belum bisa menuliskannya.
//
// Modul transaksi (absensi, cuti, payroll, KPI) ditambahkan di migrasi masing-masing.
// URL koneksi diambil dari DATABASE_URL lewat prisma.config.ts.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "esm"
  previewFeatures = ["postgresqlExtensions", "partialIndexes"]
}

datasource db {
  provider   = "postgresql"
  // pg_trgm: index GIN untuk pencarian nama/NIP dengan ILIKE '%kata%'.
  // btree_gist: EXCLUDE constraint anti tumpang tindih di leave_requests
  // (uuid = dan daterange && dalam satu index GiST).
  extensions = [pg_trgm, btree_gist]
}

// ---------------------------------------------------------------------------
// Enum
// ---------------------------------------------------------------------------

enum Role {
  HR
  EMPLOYEE

  @@map("role")
}

enum Gender {
  MALE
  FEMALE

  @@map("gender")
}

enum EmploymentStatus {
  PERMANENT
  CONTRACT

  @@map("employment_status")
}

/// Tempat kerja saat absen. WFH dan BUSINESS_TRIP hanya dengan izin yang disetujui.
enum AttendanceMode {
  OFFICE
  WFH
  BUSINESS_TRIP

  @@map("attendance_mode")
}

/// ON_TIME/LATE/EARLY_LEAVE = hadir (ada clockInAt). LEAVE/SICK/PERMIT diisi
/// modul cuti, ABSENT diisi job harian 23:59 WIB.
enum AttendanceStatus {
  ON_TIME
  LATE
  EARLY_LEAVE
  LEAVE
  SICK
  PERMIT
  ABSENT

  @@map("attendance_status")
}

// ---------------------------------------------------------------------------
// Akun dan karyawan
// ---------------------------------------------------------------------------

/// Akun login. Email disimpan huruf kecil (dicek CHECK constraint).
model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         Role      @default(EMPLOYEE)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  employee              Employee?
  auditLogs             AuditLog[]
  refreshTokens         RefreshToken[]
  passwordResetTokens   PasswordResetToken[]
  reviewedLeaveRequests LeaveRequest[]
  finalizedPayrolls     PayrollPeriod[]
  kpiReviewsGiven       KpiReview[]

  @@map("users")
}

/// Data karyawan, satu per akun. Soft delete lewat deletedAt: query lewat
/// PrismaService.client otomatis mengabaikan baris yang sudah dihapus.
model Employee {
  id               String           @id @default(uuid(7)) @db.Uuid
  userId           String           @unique @map("user_id") @db.Uuid
  /// Format BRT-YYYY-NNNN, huruf besar (dicek CHECK constraint).
  nip              String           @unique
  fullName         String           @map("full_name")
  phone            String?
  gender           Gender?
  birthDate        DateTime?        @map("birth_date") @db.Date
  /// Object key foto di storage S3 (bukan URL publik).
  photoKey         String?          @map("photo_key")
  departmentId     String           @map("department_id") @db.Uuid
  positionId       String           @map("position_id") @db.Uuid
  officeLocationId String           @map("office_location_id") @db.Uuid
  shiftId          String           @map("shift_id") @db.Uuid
  joinDate         DateTime         @map("join_date") @db.Date
  employmentStatus EmploymentStatus @map("employment_status")
  deletedAt        DateTime?        @map("deleted_at") @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user           User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  department     Department        @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  position       Position          @relation(fields: [positionId], references: [id], onDelete: Restrict)
  officeLocation OfficeLocation    @relation(fields: [officeLocationId], references: [id], onDelete: Restrict)
  shift          Shift             @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  attendances    Attendance[]
  leaveBalances  LeaveBalance[]
  leaveRequests  LeaveRequest[]
  salaries       SalaryStructure[]
  benefits       Benefit[]
  payrollItems   PayrollItem[]
  kpiReviews     KpiReview[]

  // Filter daftar karyawan per departemen (selalu bersama deleted_at IS NULL).
  @@index([departmentId, deletedAt])
  @@index([deletedAt])
  // Index foreign key lain (JOIN dan cek ON DELETE RESTRICT).
  @@index([positionId])
  @@index([officeLocationId])
  @@index([shiftId])
  // Pencarian sebagian kata (ILIKE '%...%'), tidak bisa memakai B-tree.
  @@index([fullName(ops: raw("gin_trgm_ops"))], map: "employees_full_name_trgm_idx", type: Gin)
  @@index([nip(ops: raw("gin_trgm_ops"))], map: "employees_nip_trgm_idx", type: Gin)
  @@map("employees")
}

// ---------------------------------------------------------------------------
// Sesi dan reset password
// ---------------------------------------------------------------------------

/// Refresh token (opaque, 256-bit acak). Yang disimpan hanya hash SHA-256.
/// Setiap refresh membuat token baru dalam family yang sama; token lama
/// dicabut dan menunjuk penggantinya. Token tercabut yang dipakai lagi
/// (reuse) mencabut seluruh family.
model RefreshToken {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  /// SHA-256 hex dari token mentah.
  tokenHash    String    @unique @map("token_hash") @db.Char(64)
  /// Satu family = satu sesi login (berubah hanya saat login ulang).
  familyId     String    @map("family_id") @db.Uuid
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById String?   @unique @map("replaced_by_id") @db.Uuid
  userAgent    String?   @map("user_agent")
  ip           String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken? @relation("RefreshTokenRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   RefreshToken? @relation("RefreshTokenRotation")

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// Token reset password sekali pakai. Yang disimpan hanya hash SHA-256.
model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// SHA-256 hex dari token mentah.
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Master data organisasi
// ---------------------------------------------------------------------------

model Department {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  positions  Position[]
  employees  Employee[]
  kpiReviews KpiReview[]

  @@map("departments")
}

/// Jabatan milik satu departemen. Nama unik di dalam departemennya.
model Position {
  id           String   @id @default(uuid(7)) @db.Uuid
  name         String
  departmentId String   @map("department_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  department   Department    @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  employees    Employee[]
  kpiTemplates KpiTemplate[]
  kpiReviews   KpiReview[]

  // Kolom pertama index unik ini juga melayani foreign key department_id.
  @@unique([departmentId, name])
  @@map("positions")
}

/// Titik kantor untuk validasi jarak presensi GPS.
model OfficeLocation {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @unique
  latitude  Decimal  @db.Decimal(9, 6)
  longitude Decimal  @db.Decimal(9, 6)
  radiusM   Int      @default(100) @map("radius_m")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  employees Employee[]

  @@map("office_locations")
}

/// Jam kerja dalam WIB, disimpan sebagai teks "HH:mm".
model Shift {
  id               String   @id @default(uuid(7)) @db.Uuid
  name             String   @unique
  startTime        String   @map("start_time") @db.Char(5)
  endTime          String   @map("end_time") @db.Char(5)
  lateToleranceMin Int      @default(15) @map("late_tolerance_min")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  employees Employee[]

  @@map("shifts")
}

/// Hari libur nasional (tidak dihitung hari kerja).
model Holiday {
  id        String   @id @default(uuid(7)) @db.Uuid
  date      DateTime @unique @db.Date
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("holidays")
}

// ---------------------------------------------------------------------------
// Absensi
// ---------------------------------------------------------------------------

/// Satu baris per karyawan per tanggal WIB. Baris hadir dibuat clock-in;
/// baris tanpa clockInAt (cuti, sakit, izin, alpa) dibuat modul lain atau job.
/// Koordinat dan akurasi disimpan untuk audit HR (fake GPS tidak bisa dicegah
/// sepenuhnya dari web). Jarak selalu dihitung server.
model Attendance {
  id                String           @id @default(uuid(7)) @db.Uuid
  employeeId        String           @map("employee_id") @db.Uuid
  /// Tanggal kalender WIB.
  date              DateTime         @db.Date
  clockInAt         DateTime?        @map("clock_in_at") @db.Timestamptz(3)
  clockInLat        Decimal?         @map("clock_in_lat") @db.Decimal(9, 6)
  clockInLng        Decimal?         @map("clock_in_lng") @db.Decimal(9, 6)
  /// Jarak ke titik kantor (meter, dibulatkan).
  clockInDistanceM  Int?             @map("clock_in_distance_m")
  /// Akurasi GPS dari browser (meter).
  clockInAccuracyM  Decimal?         @map("clock_in_accuracy_m") @db.Decimal(6, 1)
  clockOutAt        DateTime?        @map("clock_out_at") @db.Timestamptz(3)
  clockOutLat       Decimal?         @map("clock_out_lat") @db.Decimal(9, 6)
  clockOutLng       Decimal?         @map("clock_out_lng") @db.Decimal(9, 6)
  clockOutDistanceM Int?             @map("clock_out_distance_m")
  clockOutAccuracyM Decimal?         @map("clock_out_accuracy_m") @db.Decimal(6, 1)
  /// Null untuk baris tanpa absen (cuti, sakit, izin, alpa).
  mode              AttendanceMode?
  status            AttendanceStatus
  /// Menit setelah jam masuk shift. Tetap tersimpan walau status jadi EARLY_LEAVE.
  lateMinutes       Int              @default(0) @map("late_minutes")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  // Mencegah absen ganda; kolom pertama juga melayani foreign key employee_id.
  @@unique([employeeId, date])
  // Log dan ringkasan HR per tanggal.
  @@index([date, status])
  @@map("attendances")
}

// ---------------------------------------------------------------------------
// Cuti, izin, WFH, dan dinas luar
// ---------------------------------------------------------------------------

/// LEAVE = cuti/sakit/izin (punya leaveTypeId). WFH dan BUSINESS_TRIP membuka
/// absen di luar radius kantor pada tanggal yang disetujui.
enum LeaveRequestKind {
  LEAVE
  WFH
  BUSINESS_TRIP

  @@map("leave_request_kind")
}

/// PENDING bisa menjadi APPROVED, REJECTED, atau CANCELLED. Tiga status
/// terakhir final.
enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED

  @@map("leave_request_status")
}

/// Jenis cuti. Data awal (ANNUAL, SICK, SPECIAL) diisi migrasi `leave_requests`.
model LeaveType {
  id                          String   @id @default(uuid(7)) @db.Uuid
  /// Kode stabil huruf besar, contoh ANNUAL (dicek CHECK constraint).
  code                        String   @unique
  name                        String
  /// Kuota hari kerja per tahun kalender. Null = tidak terbatas.
  annualQuota                 Int?     @map("annual_quota")
  /// Disetujui = LeaveBalance.used bertambah. Hanya cuti tahunan.
  deductsQuota                Boolean  @default(false) @map("deducts_quota")
  /// Lampiran wajib jika hari kerja lebih dari nilai ini. Null = opsional.
  attachmentRequiredAfterDays Int?     @map("attachment_required_after_days")
  createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  requests LeaveRequest[]

  @@map("leave_types")
}

/// Kuota cuti tahunan per karyawan per tahun. Sisa = quota - used.
/// CHECK constraint used <= quota adalah pengaman terakhir: approve menambah
/// used dengan satu UPDATE bersyarat, bukan baca-cek-tulis.
model LeaveBalance {
  id         String   @id @default(uuid(7)) @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  year       Int
  quota      Int
  used       Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  // Kolom pertama juga melayani foreign key employee_id.
  @@unique([employeeId, year])
  @@map("leave_balances")
}

/// Pengajuan cuti, WFH, atau dinas luar. Pengajuan PENDING/APPROVED milik
/// satu karyawan tidak boleh tumpang tindih (EXCLUDE constraint di migrasi).
model LeaveRequest {
  id            String             @id @default(uuid(7)) @db.Uuid
  employeeId    String             @map("employee_id") @db.Uuid
  kind          LeaveRequestKind
  /// Wajib untuk kind LEAVE, kosong untuk WFH/BUSINESS_TRIP.
  leaveTypeId   String?            @map("leave_type_id") @db.Uuid
  startDate     DateTime           @map("start_date") @db.Date
  endDate       DateTime           @map("end_date") @db.Date
  /// Hari kerja dalam rentang (tanpa akhir pekan dan libur). Dihitung ulang saat approve.
  workingDays   Int                @map("working_days")
  reason        String
  /// Kota/lokasi tujuan, wajib untuk BUSINESS_TRIP.
  destination   String?
  /// Object key lampiran di storage: leave/<employeeId>/<uuid>.
  attachmentKey String?            @map("attachment_key")
  status        LeaveRequestStatus @default(PENDING)
  /// Akun HR yang menyetujui/menolak.
  reviewedById  String?            @map("reviewed_by_id") @db.Uuid
  reviewedAt    DateTime?          @map("reviewed_at") @db.Timestamptz(3)
  reviewNote    String?            @map("review_note")
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  leaveType  LeaveType? @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  reviewedBy User?      @relation(fields: [reviewedById], references: [id], onDelete: Restrict)

  // Riwayat milik karyawan, cek tumpang tindih, dan izin WFH/dinas per tanggal.
  @@index([employeeId, startDate])
  // Daftar HR: filter status, urut tanggal mulai terdekat.
  @@index([status, startDate])
  @@index([leaveTypeId])
  @@index([reviewedById])
  @@map("leave_requests")
}

// ---------------------------------------------------------------------------
// Gaji, manfaat, dan payroll
// ---------------------------------------------------------------------------

/// Program BPJS yang tarifnya diatur di PayrollConfig.
enum PayrollConfigKey {
  BPJS_KES
  JHT
  JP
  JKK
  JKM

  @@map("payroll_config_key")
}

/// DRAFT -> FINAL -> PAID. FINAL bisa dibuka kembali ke DRAFT; PAID final.
enum PayrollPeriodStatus {
  DRAFT
  FINAL
  PAID

  @@map("payroll_period_status")
}

/// Status file PDF slip (dibuat worker, queue "payslip-pdf").
/// NONE: belum diminta (periode DRAFT atau setelah reopen). QUEUED: menunggu
/// atau sedang dibuat. READY: PDF ada di slipKey. FAILED: gagal setelah
/// semua percobaan, alasan di slipError.
enum SlipStatus {
  NONE
  QUEUED
  READY
  FAILED

  @@map("slip_status")
}

enum BenefitStatus {
  ACTIVE
  INACTIVE

  @@map("benefit_status")
}

/// Struktur gaji karyawan. Hanya ditambah, tidak pernah diubah: kenaikan
/// gaji = baris baru dengan effectiveFrom baru. Yang berlaku untuk satu
/// tanggal = effectiveFrom terbaru <= tanggal itu (yang dibuat terakhir jika sama).
model SalaryStructure {
  id               String   @id @default(uuid(7)) @db.Uuid
  employeeId       String   @map("employee_id") @db.Uuid
  baseSalary       Decimal  @map("base_salary") @db.Decimal(15, 2)
  fixedAllowance   Decimal  @default(0) @map("fixed_allowance") @db.Decimal(15, 2)
  bankName         String   @map("bank_name")
  /// Hanya 4 digit terakhir rekening yang disimpan.
  bankAccountLast4 String   @map("bank_account_last4") @db.Char(4)
  effectiveFrom    DateTime @map("effective_from") @db.Date
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  // Riwayat per karyawan dan pencarian struktur yang berlaku.
  @@index([employeeId, effectiveFrom])
  @@map("salary_structures")
}

/// BPJS dan asuransi swasta milik karyawan.
model Benefit {
  id         String        @id @default(uuid(7)) @db.Uuid
  employeeId String        @map("employee_id") @db.Uuid
  /// Contoh: BPJS Kesehatan, BPJS Ketenagakerjaan, Asuransi Kesehatan Kumpulan.
  provider   String
  /// Contoh: JKN; JHT, JKK, JKM, JP.
  program    String?
  cardNo     String?       @map("card_no")
  /// Kelas rawat atau plan, contoh Kelas 1, Plan A.
  class      String?
  dependents Int           @default(0)
  status     BenefitStatus @default(ACTIVE)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId])
  @@map("benefits")
}

/// Tarif BPJS per program. Tarif berupa pecahan (0.0100 = 1%). Perubahan
/// tarif/batas upah = baris baru dengan effectiveFrom baru; baris lama tetap.
/// Periode payroll memakai baris terbaru dengan effectiveFrom <= awal bulan.
model PayrollConfig {
  id            String           @id @default(uuid(7)) @db.Uuid
  key           PayrollConfigKey
  employeeRate  Decimal          @map("employee_rate") @db.Decimal(7, 4)
  employerRate  Decimal          @map("employer_rate") @db.Decimal(7, 4)
  /// Batas atas dasar upah. Null = tanpa batas.
  wageCap       Decimal?         @map("wage_cap") @db.Decimal(15, 2)
  effectiveFrom DateTime         @map("effective_from") @db.Date
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([key, effectiveFrom])
  @@map("payroll_configs")
}

/// Satu payroll per bulan ("YYYY-MM").
model PayrollPeriod {
  id            String              @id @default(uuid(7)) @db.Uuid
  period        String              @unique @db.Char(7)
  status        PayrollPeriodStatus @default(DRAFT)
  finalizedById String?             @map("finalized_by_id") @db.Uuid
  finalizedAt   DateTime?           @map("finalized_at") @db.Timestamptz(3)
  paidAt        DateTime?           @map("paid_at") @db.Timestamptz(3)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  finalizedBy User?         @relation(fields: [finalizedById], references: [id], onDelete: Restrict)
  items       PayrollItem[]

  @@index([finalizedById])
  @@map("payroll_periods")
}

/// Slip gaji satu karyawan di satu periode. Semua angka dan data karyawan
/// adalah snapshot saat payroll dijalankan; slip FINAL/PAID tidak pernah
/// dihitung ulang dari data gaji yang sekarang.
model PayrollItem {
  id                    String     @id @default(uuid(7)) @db.Uuid
  periodId              String     @map("period_id") @db.Uuid
  employeeId            String     @map("employee_id") @db.Uuid
  employeeName          String     @map("employee_name")
  nip                   String
  departmentName        String     @map("department_name")
  positionName          String     @map("position_name")
  bankName              String     @map("bank_name")
  bankAccountLast4      String     @map("bank_account_last4") @db.Char(4)
  baseSalary            Decimal    @map("base_salary") @db.Decimal(15, 2)
  fixedAllowance        Decimal    @map("fixed_allowance") @db.Decimal(15, 2)
  /// Diisi HR, dipertahankan saat payroll dijalankan ulang.
  bonus                 Decimal    @default(0) @db.Decimal(15, 2)
  gross                 Decimal    @db.Decimal(15, 2)
  bpjsKes               Decimal    @map("bpjs_kes") @db.Decimal(15, 2)
  bpjsJht               Decimal    @map("bpjs_jht") @db.Decimal(15, 2)
  bpjsJp                Decimal    @map("bpjs_jp") @db.Decimal(15, 2)
  /// Diinput manual oleh HR (PRD 6.4), dipertahankan saat dijalankan ulang.
  pph21                 Decimal    @default(0) @db.Decimal(15, 2)
  otherDeductions       Decimal    @default(0) @map("other_deductions") @db.Decimal(15, 2)
  net                   Decimal    @db.Decimal(15, 2)
  /// Bagian perusahaan per program + total (rupiah sebagai teks).
  employerContributions Json       @map("employer_contributions")
  /// Tarif dan batas upah yang dipakai menghitung slip ini.
  configSnapshot        Json       @map("config_snapshot")
  note                  String?
  /// Object key PDF slip di storage: payslips/<period>/<employeeId>.pdf.
  slipKey               String?    @map("slip_key")
  slipStatus            SlipStatus @default(NONE) @map("slip_status")
  /// Alasan gagal percobaan terakhir (diisi saat FAILED).
  slipError             String?    @map("slip_error")
  createdAt             DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  period   PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)
  employee Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  // Satu slip per karyawan per periode; kolom pertama melayani FK period_id.
  @@unique([periodId, employeeId])
  // Slip milik karyawan (/payslips/me).
  @@index([employeeId])
  @@map("payroll_items")
}

// ---------------------------------------------------------------------------
// KPI (hanya HR; karyawan tidak punya akses sama sekali, PRD 6.5)
// ---------------------------------------------------------------------------

/// DRAFT -> ACTIVE (penilaian dibuat) -> CLOSED. Hanya satu periode ACTIVE.
enum KpiPeriodStatus {
  DRAFT
  ACTIVE
  CLOSED

  @@map("kpi_period_status")
}

/// DRAFT: skor bisa diisi. FINAL: skor dan nilai akhir terkunci.
enum KpiReviewStatus {
  DRAFT
  FINAL

  @@map("kpi_review_status")
}

/// A 85-100, B 70-84, C 55-69, D di bawah 55 (dari nilai akhir 1 desimal).
enum KpiGrade {
  A
  B
  C
  D

  @@map("kpi_grade")
}

/// Template KPI per jabatan. Satu template aktif per jabatan; template valid
/// jika punya indikator dan total bobotnya tepat 100.
model KpiTemplate {
  id         String   @id @default(uuid(7)) @db.Uuid
  positionId String   @map("position_id") @db.Uuid
  name       String
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  position   Position       @relation(fields: [positionId], references: [id], onDelete: Cascade)
  indicators KpiIndicator[]
  reviews    KpiReview[]

  @@unique([positionId], map: "kpi_templates_one_active_per_position", where: raw("is_active"))
  @@index([positionId])
  @@map("kpi_templates")
}

/// Indikator template. Bobot dalam persen (Decimal 5,2), total satu template = 100.
model KpiIndicator {
  id          String   @id @default(uuid(7)) @db.Uuid
  templateId  String   @map("template_id") @db.Uuid
  name        String
  description String?
  weight      Decimal  @db.Decimal(5, 2)
  target      String?
  order       Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  template KpiTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, order])
  @@map("kpi_indicators")
}

/// Periode penilaian, contoh "Q1 2026". Tenggat pengisian diatur HR.
model KpiPeriod {
  id          String          @id @default(uuid(7)) @db.Uuid
  name        String          @unique
  startDate   DateTime        @map("start_date") @db.Date
  endDate     DateTime        @map("end_date") @db.Date
  deadline    DateTime        @db.Date
  status      KpiPeriodStatus @default(DRAFT)
  activatedAt DateTime?       @map("activated_at") @db.Timestamptz(3)
  closedAt    DateTime?       @map("closed_at") @db.Timestamptz(3)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  reviews KpiReview[]

  @@unique([status], map: "kpi_periods_one_active", where: raw("status = 'ACTIVE'"))
  @@map("kpi_periods")
}

/// Penilaian satu karyawan di satu periode, dibuat saat periode diaktifkan.
/// Jabatan, departemen, dan template adalah snapshot saat aktivasi;
/// indikator dan bobotnya disalin ke KpiScore.
model KpiReview {
  id           String          @id @default(uuid(7)) @db.Uuid
  periodId     String          @map("period_id") @db.Uuid
  employeeId   String          @map("employee_id") @db.Uuid
  /// HR terakhir yang menyimpan skor atau memfinalkan. Null = belum dinilai.
  reviewerId   String?         @map("reviewer_id") @db.Uuid
  positionId   String?         @map("position_id") @db.Uuid
  departmentId String?         @map("department_id") @db.Uuid
  templateId   String?         @map("template_id") @db.Uuid
  /// Jumlah(skor x bobot / 100), dibulatkan 1 desimal saat finalisasi.
  finalScore   Decimal?        @map("final_score") @db.Decimal(5, 2)
  grade        KpiGrade?
  note         String?
  status       KpiReviewStatus @default(DRAFT)
  finalizedAt  DateTime?       @map("finalized_at") @db.Timestamptz(3)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  period     KpiPeriod    @relation(fields: [periodId], references: [id], onDelete: Restrict)
  employee   Employee     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  reviewer   User?        @relation(fields: [reviewerId], references: [id], onDelete: Restrict)
  position   Position?    @relation(fields: [positionId], references: [id], onDelete: SetNull)
  department Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  template   KpiTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  scores     KpiScore[]

  // Satu penilaian per karyawan per periode; kolom pertama melayani FK period_id.
  @@unique([periodId, employeeId])
  @@index([employeeId])
  @@index([reviewerId])
  @@index([positionId])
  @@index([departmentId])
  @@index([templateId])
  @@map("kpi_reviews")
}

/// Skor satu indikator di satu penilaian. Nama, deskripsi, bobot, target,
/// dan urutan adalah snapshot indikator saat periode diaktifkan, jadi
/// perubahan template tidak mengubah penilaian. indicatorId sengaja bukan
/// foreign key: indikator template boleh diubah atau dihapus kemudian.
model KpiScore {
  id          String   @id @default(uuid(7)) @db.Uuid
  reviewId    String   @map("review_id") @db.Uuid
  indicatorId String   @map("indicator_id") @db.Uuid
  name        String
  description String?
  weight      Decimal  @db.Decimal(5, 2)
  target      String?
  order       Int      @map("sort_order")
  /// 0-100, maksimal 2 desimal. Null = belum diisi.
  score       Decimal? @db.Decimal(5, 2)
  note        String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  review KpiReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, indicatorId])
  @@map("kpi_scores")
}

// ---------------------------------------------------------------------------
// Sistem
// ---------------------------------------------------------------------------

/// Jejak perubahan data. Hanya ditambah, tidak pernah diubah (tanpa updatedAt).
model AuditLog {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// Null untuk aksi sistem (job terjadwal, seed).
  actorId   String?  @map("actor_id") @db.Uuid
  /// Contoh: employee.create, employee.soft_delete.
  action    String
  /// Nama model yang berubah, contoh: Employee.
  entity    String
  /// Teks, bukan uuid: CompanySetting memakai key sebagai id.
  entityId  String   @map("entity_id")
  before    Json?
  after     Json?
  ip        String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entity, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

/// Pengaturan perusahaan (key/value), contoh hr_contact.
model CompanySetting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("company_settings")
}
