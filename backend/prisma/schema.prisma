// Skema database HRIS Blue Rose Tech.
//
// Aturan:
// - Perubahan skema hanya lewat `npx prisma migrate dev --name <nama>`.
//   Jangan edit migrasi yang sudah ada dan jangan ubah database secara manual.
// - Kolom uang memakai tipe Decimal (Prisma.Decimal di kode), tidak pernah Float.
// - Nama model/field camelCase di kode, snake_case di database (@map/@@map).
// - id = UUIDv7 (urut waktu, index B-tree tidak terfragmentasi), dibuat Prisma Client.
// - Timestamp memakai timestamptz; tanggal kalender (lahir, masuk, libur) memakai date.
// - CHECK constraint (format NIP, jam shift, koordinat) ada di SQL migrasi
//   karena Prisma Schema belum bisa menuliskannya.
//
// Modul transaksi (absensi, cuti, payroll, KPI) ditambahkan di migrasi masing-masing.
// URL koneksi diambil dari DATABASE_URL lewat prisma.config.ts.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "esm"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  // pg_trgm: index GIN untuk pencarian nama/NIP dengan ILIKE '%kata%'.
  // btree_gist: EXCLUDE constraint anti tumpang tindih di leave_requests
  // (uuid = dan daterange && dalam satu index GiST).
  extensions = [pg_trgm, btree_gist]
}

// ---------------------------------------------------------------------------
// Enum
// ---------------------------------------------------------------------------

enum Role {
  HR
  EMPLOYEE

  @@map("role")
}

enum Gender {
  MALE
  FEMALE

  @@map("gender")
}

enum EmploymentStatus {
  PERMANENT
  CONTRACT

  @@map("employment_status")
}

/// Tempat kerja saat absen. WFH dan BUSINESS_TRIP hanya dengan izin yang disetujui.
enum AttendanceMode {
  OFFICE
  WFH
  BUSINESS_TRIP

  @@map("attendance_mode")
}

/// ON_TIME/LATE/EARLY_LEAVE = hadir (ada clockInAt). LEAVE/SICK/PERMIT diisi
/// modul cuti, ABSENT diisi job harian 23:59 WIB.
enum AttendanceStatus {
  ON_TIME
  LATE
  EARLY_LEAVE
  LEAVE
  SICK
  PERMIT
  ABSENT

  @@map("attendance_status")
}

// ---------------------------------------------------------------------------
// Akun dan karyawan
// ---------------------------------------------------------------------------

/// Akun login. Email disimpan huruf kecil (dicek CHECK constraint).
model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         Role      @default(EMPLOYEE)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  employee              Employee?
  auditLogs             AuditLog[]
  refreshTokens         RefreshToken[]
  passwordResetTokens   PasswordResetToken[]
  reviewedLeaveRequests LeaveRequest[]

  @@map("users")
}

/// Data karyawan, satu per akun. Soft delete lewat deletedAt: query lewat
/// PrismaService.client otomatis mengabaikan baris yang sudah dihapus.
model Employee {
  id               String           @id @default(uuid(7)) @db.Uuid
  userId           String           @unique @map("user_id") @db.Uuid
  /// Format BRT-YYYY-NNNN, huruf besar (dicek CHECK constraint).
  nip              String           @unique
  fullName         String           @map("full_name")
  phone            String?
  gender           Gender?
  birthDate        DateTime?        @map("birth_date") @db.Date
  /// Object key foto di storage S3 (bukan URL publik).
  photoKey         String?          @map("photo_key")
  departmentId     String           @map("department_id") @db.Uuid
  positionId       String           @map("position_id") @db.Uuid
  officeLocationId String           @map("office_location_id") @db.Uuid
  shiftId          String           @map("shift_id") @db.Uuid
  joinDate         DateTime         @map("join_date") @db.Date
  employmentStatus EmploymentStatus @map("employment_status")
  deletedAt        DateTime?        @map("deleted_at") @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user           User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  department     Department     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  position       Position       @relation(fields: [positionId], references: [id], onDelete: Restrict)
  officeLocation OfficeLocation @relation(fields: [officeLocationId], references: [id], onDelete: Restrict)
  shift          Shift          @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  attendances    Attendance[]
  leaveBalances  LeaveBalance[]
  leaveRequests  LeaveRequest[]

  // Filter daftar karyawan per departemen (selalu bersama deleted_at IS NULL).
  @@index([departmentId, deletedAt])
  @@index([deletedAt])
  // Index foreign key lain (JOIN dan cek ON DELETE RESTRICT).
  @@index([positionId])
  @@index([officeLocationId])
  @@index([shiftId])
  // Pencarian sebagian kata (ILIKE '%...%'), tidak bisa memakai B-tree.
  @@index([fullName(ops: raw("gin_trgm_ops"))], map: "employees_full_name_trgm_idx", type: Gin)
  @@index([nip(ops: raw("gin_trgm_ops"))], map: "employees_nip_trgm_idx", type: Gin)
  @@map("employees")
}

// ---------------------------------------------------------------------------
// Sesi dan reset password
// ---------------------------------------------------------------------------

/// Refresh token (opaque, 256-bit acak). Yang disimpan hanya hash SHA-256.
/// Setiap refresh membuat token baru dalam family yang sama; token lama
/// dicabut dan menunjuk penggantinya. Token tercabut yang dipakai lagi
/// (reuse) mencabut seluruh family.
model RefreshToken {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  /// SHA-256 hex dari token mentah.
  tokenHash    String    @unique @map("token_hash") @db.Char(64)
  /// Satu family = satu sesi login (berubah hanya saat login ulang).
  familyId     String    @map("family_id") @db.Uuid
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById String?   @unique @map("replaced_by_id") @db.Uuid
  userAgent    String?   @map("user_agent")
  ip           String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken? @relation("RefreshTokenRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   RefreshToken? @relation("RefreshTokenRotation")

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// Token reset password sekali pakai. Yang disimpan hanya hash SHA-256.
model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// SHA-256 hex dari token mentah.
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Master data organisasi
// ---------------------------------------------------------------------------

model Department {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  positions Position[]
  employees Employee[]

  @@map("departments")
}

/// Jabatan milik satu departemen. Nama unik di dalam departemennya.
model Position {
  id           String   @id @default(uuid(7)) @db.Uuid
  name         String
  departmentId String   @map("department_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  employees  Employee[]

  // Kolom pertama index unik ini juga melayani foreign key department_id.
  @@unique([departmentId, name])
  @@map("positions")
}

/// Titik kantor untuk validasi jarak presensi GPS.
model OfficeLocation {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @unique
  latitude  Decimal  @db.Decimal(9, 6)
  longitude Decimal  @db.Decimal(9, 6)
  radiusM   Int      @default(100) @map("radius_m")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  employees Employee[]

  @@map("office_locations")
}

/// Jam kerja dalam WIB, disimpan sebagai teks "HH:mm".
model Shift {
  id               String   @id @default(uuid(7)) @db.Uuid
  name             String   @unique
  startTime        String   @map("start_time") @db.Char(5)
  endTime          String   @map("end_time") @db.Char(5)
  lateToleranceMin Int      @default(15) @map("late_tolerance_min")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  employees Employee[]

  @@map("shifts")
}

/// Hari libur nasional (tidak dihitung hari kerja).
model Holiday {
  id        String   @id @default(uuid(7)) @db.Uuid
  date      DateTime @unique @db.Date
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("holidays")
}

// ---------------------------------------------------------------------------
// Absensi
// ---------------------------------------------------------------------------

/// Satu baris per karyawan per tanggal WIB. Baris hadir dibuat clock-in;
/// baris tanpa clockInAt (cuti, sakit, izin, alpa) dibuat modul lain atau job.
/// Koordinat dan akurasi disimpan untuk audit HR (fake GPS tidak bisa dicegah
/// sepenuhnya dari web). Jarak selalu dihitung server.
model Attendance {
  id                String           @id @default(uuid(7)) @db.Uuid
  employeeId        String           @map("employee_id") @db.Uuid
  /// Tanggal kalender WIB.
  date              DateTime         @db.Date
  clockInAt         DateTime?        @map("clock_in_at") @db.Timestamptz(3)
  clockInLat        Decimal?         @map("clock_in_lat") @db.Decimal(9, 6)
  clockInLng        Decimal?         @map("clock_in_lng") @db.Decimal(9, 6)
  /// Jarak ke titik kantor (meter, dibulatkan).
  clockInDistanceM  Int?             @map("clock_in_distance_m")
  /// Akurasi GPS dari browser (meter).
  clockInAccuracyM  Decimal?         @map("clock_in_accuracy_m") @db.Decimal(6, 1)
  clockOutAt        DateTime?        @map("clock_out_at") @db.Timestamptz(3)
  clockOutLat       Decimal?         @map("clock_out_lat") @db.Decimal(9, 6)
  clockOutLng       Decimal?         @map("clock_out_lng") @db.Decimal(9, 6)
  clockOutDistanceM Int?             @map("clock_out_distance_m")
  clockOutAccuracyM Decimal?         @map("clock_out_accuracy_m") @db.Decimal(6, 1)
  /// Null untuk baris tanpa absen (cuti, sakit, izin, alpa).
  mode              AttendanceMode?
  status            AttendanceStatus
  /// Menit setelah jam masuk shift. Tetap tersimpan walau status jadi EARLY_LEAVE.
  lateMinutes       Int              @default(0) @map("late_minutes")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  // Mencegah absen ganda; kolom pertama juga melayani foreign key employee_id.
  @@unique([employeeId, date])
  // Log dan ringkasan HR per tanggal.
  @@index([date, status])
  @@map("attendances")
}

// ---------------------------------------------------------------------------
// Cuti, izin, WFH, dan dinas luar
// ---------------------------------------------------------------------------

/// LEAVE = cuti/sakit/izin (punya leaveTypeId). WFH dan BUSINESS_TRIP membuka
/// absen di luar radius kantor pada tanggal yang disetujui.
enum LeaveRequestKind {
  LEAVE
  WFH
  BUSINESS_TRIP

  @@map("leave_request_kind")
}

/// PENDING bisa menjadi APPROVED, REJECTED, atau CANCELLED. Tiga status
/// terakhir final.
enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED

  @@map("leave_request_status")
}

/// Jenis cuti. Data awal (ANNUAL, SICK, SPECIAL) diisi migrasi `leave_requests`.
model LeaveType {
  id                          String   @id @default(uuid(7)) @db.Uuid
  /// Kode stabil huruf besar, contoh ANNUAL (dicek CHECK constraint).
  code                        String   @unique
  name                        String
  /// Kuota hari kerja per tahun kalender. Null = tidak terbatas.
  annualQuota                 Int?     @map("annual_quota")
  /// Disetujui = LeaveBalance.used bertambah. Hanya cuti tahunan.
  deductsQuota                Boolean  @default(false) @map("deducts_quota")
  /// Lampiran wajib jika hari kerja lebih dari nilai ini. Null = opsional.
  attachmentRequiredAfterDays Int?     @map("attachment_required_after_days")
  createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  requests LeaveRequest[]

  @@map("leave_types")
}

/// Kuota cuti tahunan per karyawan per tahun. Sisa = quota - used.
/// CHECK constraint used <= quota adalah pengaman terakhir: approve menambah
/// used dengan satu UPDATE bersyarat, bukan baca-cek-tulis.
model LeaveBalance {
  id         String   @id @default(uuid(7)) @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  year       Int
  quota      Int
  used       Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  // Kolom pertama juga melayani foreign key employee_id.
  @@unique([employeeId, year])
  @@map("leave_balances")
}

/// Pengajuan cuti, WFH, atau dinas luar. Pengajuan PENDING/APPROVED milik
/// satu karyawan tidak boleh tumpang tindih (EXCLUDE constraint di migrasi).
model LeaveRequest {
  id            String             @id @default(uuid(7)) @db.Uuid
  employeeId    String             @map("employee_id") @db.Uuid
  kind          LeaveRequestKind
  /// Wajib untuk kind LEAVE, kosong untuk WFH/BUSINESS_TRIP.
  leaveTypeId   String?            @map("leave_type_id") @db.Uuid
  startDate     DateTime           @map("start_date") @db.Date
  endDate       DateTime           @map("end_date") @db.Date
  /// Hari kerja dalam rentang (tanpa akhir pekan dan libur). Dihitung ulang saat approve.
  workingDays   Int                @map("working_days")
  reason        String
  /// Kota/lokasi tujuan, wajib untuk BUSINESS_TRIP.
  destination   String?
  /// Object key lampiran di storage: leave/<employeeId>/<uuid>.
  attachmentKey String?            @map("attachment_key")
  status        LeaveRequestStatus @default(PENDING)
  /// Akun HR yang menyetujui/menolak.
  reviewedById  String?            @map("reviewed_by_id") @db.Uuid
  reviewedAt    DateTime?          @map("reviewed_at") @db.Timestamptz(3)
  reviewNote    String?            @map("review_note")
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  leaveType  LeaveType? @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  reviewedBy User?      @relation(fields: [reviewedById], references: [id], onDelete: Restrict)

  // Riwayat milik karyawan, cek tumpang tindih, dan izin WFH/dinas per tanggal.
  @@index([employeeId, startDate])
  // Daftar HR: filter status, urut tanggal mulai terdekat.
  @@index([status, startDate])
  @@index([leaveTypeId])
  @@index([reviewedById])
  @@map("leave_requests")
}

// ---------------------------------------------------------------------------
// Sistem
// ---------------------------------------------------------------------------

/// Jejak perubahan data. Hanya ditambah, tidak pernah diubah (tanpa updatedAt).
model AuditLog {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// Null untuk aksi sistem (job terjadwal, seed).
  actorId   String?  @map("actor_id") @db.Uuid
  /// Contoh: employee.create, employee.soft_delete.
  action    String
  /// Nama model yang berubah, contoh: Employee.
  entity    String
  /// Teks, bukan uuid: CompanySetting memakai key sebagai id.
  entityId  String   @map("entity_id")
  before    Json?
  after     Json?
  ip        String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entity, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

/// Pengaturan perusahaan (key/value), contoh hr_contact.
model CompanySetting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("company_settings")
}
